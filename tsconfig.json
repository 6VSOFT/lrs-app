{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": { "@engine/*": ["shared/engine/*"] },
    "noUnusedLocals": true,
    "types": ["vite/client"]
  },
  "include": ["src", "tests", "shared", "vite.config.ts"]
}
